# Exact, stable images. Do not use floating tags.
PYTHON_IMAGE=python:3.12.13-slim-trixie
PORTAL_IMAGE=vllm-management-portal:0.1.0
DOCKER_SOCKET_PROXY_IMAGE=tecnativa/docker-socket-proxy:v0.4.2

# Portal listener and persistent manager-only data.
PORTAL_BIND_ADDRESS=0.0.0.0
PORTAL_PORT=8088
PORTAL_CONTAINER_HOSTNAME=inference-dashboard
PORTAL_DATA_DIR=/var/lib/vllm-management-portal
RESTART_POLICY=unless-stopped
HOST_ROUTE_PROBE_IP=1.1.1.1

# Existing inference integration. Use vllm or llama_cpp.
INFERENCE_BACKEND=vllm
INFERENCE_HOSTNAME=inference-host
INFERENCE_BASE_URL=http://host.docker.internal:8000
ROCM_PATH=/opt/rocm-7.2.2
AMDGPU_IDS_PATH=/opt/amdgpu/share/libdrm/amdgpu.ids
MODEL_CACHE_PATH=/var/lib/vllm/huggingface/hub
VIDEO_GID=44
RENDER_GID=992
